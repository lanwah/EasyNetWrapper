<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <targets>
    <target name="console" xsi:type="Console" layout="${callsite} ${message}" />

    <target name="logFile" xsi:type="File"
				fileName="${basedir}/Logs/logFile_current.log"
				archiveFileName="${basedir}/Logs/logFile_{#}.log"
				archiveNumbering="Date"
				archiveEvery="Day"
				archiveDateFormat="yyyyMMdd"
				maxArchiveFiles="14"
				concurrentWrites="true"
				enableArchiveFileCompression="true"
				encoding="utf-8">
      <layout type='CompoundLayout'>
        <layout type='SimpleLayout' text="${callsite} ${message}" />
      </layout>
    </target>
  </targets>

  <rules>
    <logger name="*" minlevel="Debug" writeTo="console,logFile" />
  </rules>

</nlog>
